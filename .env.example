# Modèle de configuration. Copier ce fichier en ".env" puis remplacer les valeurs.
# Le fichier ".env" ne doit JAMAIS être versionné. Voir README.md et SECURITY.md.

# --- Base de données PostgreSQL (Supabase : Connect -> Session pooler) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-du-pooler>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<mot-de-passe-de-la-base>

# --- Compte de service de l'API (seul le hash BCrypt est stocké) ---
APP_AUTH_USERNAME=<nom-du-compte>
APP_AUTH_PASSWORD_HASH=<hash-bcrypt>

# --- JWT ---
# Secret de signature, 32 caractères minimum : python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=<secret-aleatoire>
# Durée de validité d'un jeton, en minutes (30 par défaut)
# APP_JWT_EXPIRATION_MINUTES=30

# --- Stockage S3 (Supabase : Storage -> S3 Configuration) ---
APP_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
APP_S3_REGION=eu-west-2
APP_S3_BUCKET=scanned-docs
APP_S3_ACCESS_KEY=<access-key-id>
APP_S3_SECRET_KEY=<secret-access-key>

# --- Divers ---
# Schéma de base : update (crée/modifie les tables) ou validate (production, une fois les tables créées)
# APP_DDL_AUTO=update
# PORT=8080
